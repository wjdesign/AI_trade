# ============================================================
# 永豐金 Shioaji API 金鑰（必要）
# ============================================================
API_KEY=<前面申請的API Key>
SECRET_KEY=<前面申請的Secret Key>
PROD_API_KEY=你的正式 API KEY
PROD_SECRET_KEY=你的正式 SECRET KEY

# ============================================================
# 永豐金 CA 憑證（必要，僅正式交易模式需要）
# ============================================================
CA_CERT_PATH=<前面設定的憑證路徑>
CA_PASSWORD=<憑證密碼>

# ============================================================
# 交易模式控制（重要）
# ============================================================
# SIMULATION 環境變數控制 bot 啟動時使用的交易模式
#
#   模擬模式 (預設)：true / 1 / yes / sim / simulation / 未設定
#   正式模式：       false / 0 / no / real / production / prod
#
# ⚠️ 安全預設：未設定或值無法識別時一律為模擬模式。
# ⚠️ 切換正式交易前請完整測試模擬模式至少 2 週。
SIMULATION=true

# ============================================================
# 正式交易雙重確認（防呆機制）
# ============================================================
# 只有 SIMULATION=false 還不夠！必須同時設定 CONFIRM_REAL_MONEY 為下方字串
# （精確匹配，區分大小寫）才會真的進入正式交易模式。
#
# 若 SIMULATION=false 但 CONFIRM_REAL_MONEY 沒設或值錯誤：
#   → bot 會印出醒目警告並自動 fallback 到模擬模式（保護資金）
#
# ⚠️ 設定此值代表你完全理解：bot 接下來會用真實資金進行自動交易。
# CONFIRM_REAL_MONEY=I_KNOW_THIS_IS_REAL_MONEY

# ============================================================
# OpenAI（情緒分析，目前 bot.py 強制讀取，可填 dummy 跳過）
# ============================================================
OPENAI_API_KEY=<OpenAI API Key>

# ============================================================
# Telegram 通知（選填，未設定時不會推播交易訊號）
# ============================================================
TELEGRAM_BOT_TOKEN=<Telegram Bot Token（選填）>
TELEGRAM_CHAT_ID=<Telegram Chat ID（選填）>

# ============================================================
# Proxy（選填，網路封鎖 Telegram 時設定）
# ============================================================
# HTTPS_PROXY=http://127.0.0.1:7890
